# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model
# CLAUDE_MODEL=claude-opus-5

# --- WhatsApp Cloud API (Meta) ---
# Permanent access token of the System User in Meta Business
WHATSAPP_TOKEN=
# "Phone number ID" from WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; enter the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=change-me
# App secret (App settings > Basic) - used to verify that webhooks really come from Meta
WHATSAPP_APP_SECRET=

# Only these numbers may give the bot commands (international format, digits only, comma separated)
ALLOWED_NUMBERS=9725XXXXXXXX

# --- General ---
PORT=3000
TIMEZONE=Asia/Jerusalem
DATA_FILE=./data/db.json
